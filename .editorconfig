root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# gofmt owns Go formatting: tabs, and it wins over anything written here.
[*.go]
indent_style = tab

# Makefiles require hard tabs.
[Makefile]
indent_style = tab

[*.{json,yaml,yml}]
indent_size = 2

[*.sh]
indent_size = 2

#!/usr/bin/env bash
# Thin exec: the canonical pre-push hook lives in the code.examples.ci
# submodule (ci/conventions/scripts/pre-push) and runs from disk — no
# network, no gh at hook time. Opt in with scripts/setup-git-hooks.sh; CI
# enforces the same rules via the SHA-pinned conventions action either way.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
hook="${ROOT}/ci/conventions/scripts/pre-push"
if [[ ! -f "${hook}" ]]; then
  echo "the code.examples.ci submodule is not initialized — run: git submodule update --init ci" >&2
  exit 2
fi
exec bash "${hook}" "$@"

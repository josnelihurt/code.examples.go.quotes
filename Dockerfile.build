# syntax=docker/dockerfile:1

# Hermetic OpenAPI freeze for the v3 quotes contract: buf feeds the proto's descriptors
# (leading comments + google.api.http rules + openapiv2 options) to protoc-gen-openapiv2,
# and the generated Swagger 2.0 document is committed under docs/openapi/ — generated,
# never hand-edited. Extract with ./scripts/update-contracts.sh (podman|docker build +
# copy out of the scratch stage); CI re-runs the same build in the contract-drift job.
# The stage is self-contained: only the contract sources and the two pinned binaries —
# no Go module, nothing from the later transport layers.

# The pinned buf + protoc-gen-openapiv2 pair now comes from the prebuilt toolchain
# image instead of being downloaded + sha256-verified on every freeze: the pins and
# their checksum verification live in contracts/docker-build-base (Dockerfile + VERSION
# file), built and published to this repository's GHCR by .github/workflows/toolchain.yml
# — the digest pin on the FROM line carries the verified state forward, so what ran at
# publish time is exactly what this stage runs. The parity argument is unchanged: identical
# binaries over identical inputs (docs/adr/0003-openapi-generation-pipeline.md,
# addendum), so the versions still move only in paired PRs across both repositories,
# re-freezing in the same change.
FROM ghcr.io/josnelihurt/code.examples.go.quotes/toolchain/contracts:1.50.0-2.30.0@sha256:79769b77c7867131c38a18cf1cf1891c447574590294688b4ae03111e11c9dd2 AS generate
WORKDIR /contracts

COPY contracts/quotes/v3 ./

RUN buf generate --path quotes_v3.proto \
 && mkdir -p /out/docs/openapi \
 && cp /tmp/quotes_v3.swagger.json /out/docs/openapi/quotes-v3.openapi.json

FROM scratch AS contracts
COPY --from=generate /out/docs/openapi/quotes-v3.openapi.json /docs/openapi/quotes-v3.openapi.json

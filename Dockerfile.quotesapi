# The quotes API image (ADR 0001). Build from the repository root — the Go
# build additionally embeds the migrations (migrations/) and the frozen v3
# OpenAPI document (docs/openapi/) that the v3 transport serves:
#
#   podman build -f Dockerfile.quotesapi -t quotes-quotesapi .
#
# Builder pin and runtime pin live in scripts/images.env and are checked
# against the FROM lines by scripts/check-image-tags.sh. CGO_ENABLED=0 keeps
# the binary static so the runtime image needs no matching libc.
FROM docker.io/library/golang:1.27.0-alpine3.24 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/quotesapi ./cmd/quotesapi
COPY internal ./internal
COPY migrations ./migrations
COPY docs/openapi ./docs/openapi
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/quotesapi ./cmd/quotesapi

# Runtime: alpine (busybox wget drives the healthcheck — ADR 0001's podman
# caveat), dedicated non-root uid. /health is the readiness route (it round-
# trips the catalog database), which is exactly what a container healthcheck
# should ask.
FROM docker.io/library/alpine:3.23.5
RUN adduser -D -H -u 10001 appuser
USER appuser
COPY --from=build /out/quotesapi /usr/local/bin/quotesapi
ENV SERVER__ADDRESS=:8080
EXPOSE 8080
HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=12 \
  CMD wget -qO- http://127.0.0.1:8080/health || exit 1
ENTRYPOINT ["/usr/local/bin/quotesapi"]

{
  "swagger": "2.0",
  "info": {
    "title": "Quotes.Api | v3",
    "description": "Quote catalog for the Aspire Quotes platform, served by stock gRPC-JSON transcoding: the google.api.http rules in this contract drive the routing.\n\nEvery error response is the gRPC status envelope {code, message, details}; the machine-readable errorCode does not travel. Create answers 200 with the created quote and no Location header. Pagination is 1-based (page from 1, pageSize between 1 and 100, default 20). Send X-Correlation-Id to correlate calls; it is echoed on every response.",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "QuoteService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v3/quotes": {
      "get": {
        "summary": "Lists one page of the quote catalog in stable order. Fields not bound by the path\n(page, pageSize) travel as query parameters.",
        "operationId": "QuoteService_ListQuotes",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v3ListQuotesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "page",
            "description": "1-based page number (minimum 1).",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "pageSize",
            "description": "Items per page, between 1 and 100 (default 20).",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "QuoteService"
        ]
      },
      "post": {
        "summary": "Adds a quote to the catalog; the request body maps onto the whole message. Answers\n200 with the created quote — transcoding has no way to express 201 + Location.",
        "operationId": "QuoteService_CreateQuote",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v3Quote"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "Payload to add a quote to the catalog.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v3CreateQuoteRequest"
            }
          }
        ],
        "tags": [
          "QuoteService"
        ]
      }
    },
    "/api/v3/quotes/random": {
      "get": {
        "summary": "Returns a random quote from the catalog.",
        "operationId": "QuoteService_GetRandomQuote",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v3Quote"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "QuoteService"
        ]
      }
    },
    "/api/v3/quotes/{id}": {
      "get": {
        "summary": "Returns one quote by id.",
        "operationId": "QuoteService_GetQuoteById",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v3Quote"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "description": "Quote identifier as returned by create or list.",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "QuoteService"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v3CreateQuoteRequest": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "Quote body text."
        },
        "author": {
          "type": "string",
          "description": "Attributed author of the quote."
        }
      },
      "description": "Payload to add a quote to the catalog."
    },
    "v3ListQuotesResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v3Quote"
          },
          "description": "Quotes on this page, in stable catalog order."
        },
        "page": {
          "type": "integer",
          "format": "int32",
          "description": "1-based page number this response represents."
        },
        "pageSize": {
          "type": "integer",
          "format": "int32",
          "description": "Number of items per page that was requested."
        },
        "totalItems": {
          "type": "integer",
          "format": "int32",
          "description": "Total number of quotes in the catalog."
        },
        "totalPages": {
          "type": "integer",
          "format": "int32",
          "description": "Total number of pages at the requested page size."
        }
      },
      "description": "One page of the quote catalog."
    },
    "v3Quote": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable quote identifier."
        },
        "text": {
          "type": "string",
          "description": "Quote body text."
        },
        "author": {
          "type": "string",
          "description": "Attributed author of the quote."
        }
      },
      "description": "A quote as served to an authenticated client."
    }
  },
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "description": "Bearer JWT from the Auth API (POST /api/v1/auth/login). Reads require the quotes:read scope; create requires quotes:write.",
      "name": "Authorization",
      "in": "header"
    }
  },
  "security": [
    {
      "Bearer": []
    }
  ]
}

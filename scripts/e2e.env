# Connection values for the throwaway quotes-catalog PostgreSQL every standalone e2e
# boot path shares: scripts/e2e.sh and the CI e2e job source this file to start the
# container, so the boot paths cannot drift apart. The values are disposable by
# design — loopback-only and guarding nothing — so they are committed on purpose;
# never replace them with a real credential. Real database credentials belong to the
# compose topology (docker-compose.yaml, its own development values) or an injected
# secret like the JWT signing key. The secrets-hygiene CI job fails when these
# literals appear outside this file and its allowlist.
E2E_PG_PORT=55432
E2E_PG_USER=postgres
E2E_PG_PASSWORD=postgres
E2E_PG_DATABASE=quotesdb

# Container image pins — the repository's one copy of every container tag the
# compose topology runs (the .NET original's Aspire package pins, expressed as
# a file because there is no hosting SDK to interrogate). docker-compose.yaml
# and the two API Dockerfiles embed the same tags literally; the image-pins CI
# job (scripts/check-image-tags.sh) fails when the two sides drift apart or a
# reference floats to :latest. Bump procedure: change the tag here AND in the
# referencing file(s) in the same commit, or the gate goes red.
#
# Verified 2026-08-25 via Docker Hub + ADR 0001; no floating tags.

# postgres — the quotes catalog (18.x line, the .NET stack pins 18.3)
POSTGRES_IMAGE=docker.io/library/postgres:18.6-alpine3.23

# pgweb — the dev-profile database UI (exact parity with the .NET pin)
PGWEB_IMAGE=docker.io/sosedoff/pgweb:0.17.0

# traefik — the edge reverse proxy (v3.7 is the only supported v3 line)
TRAEFIK_IMAGE=docker.io/library/traefik:v3.7.11

# nginx — the dev-profile docs server
NGINX_IMAGE=docker.io/library/nginx:1.31.4-alpine3.24

# node — the fullstack-profile frontend dev server (active LTS)
NODE_IMAGE=docker.io/library/node:24.19.0-alpine3.23

# golang — the builder stage of both API images (matches go.mod's toolchain)
GOLANG_BUILDER_IMAGE=docker.io/library/golang:1.27.0-alpine3.24

# alpine — the runtime stage of both API images (busybox wget for healthchecks)
ALPINE_RUNTIME_IMAGE=docker.io/library/alpine:3.23.5
